{
  "name": "site-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio website for a game designer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && git add dist && git commit -m \"chore: update build\" && git push origin master",
    "deploy:gh-pages": "npm run build && gh-pages -d dist",
    "format": "prettier --write .",
    "gen": "python tools/gen_pages.py",
    "gen:check": "python tools/gen_pages.py && git diff --exit-code -- src/index.html src/services.html \"src/case-*.html\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/scss/**/*.scss\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silenceremember/silenceremember.github.io.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/silenceremember/silenceremember.github.io/issues"
  },
  "homepage": "https://silenceremember.github.io",
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "eslint": "^9.39.1",
    "gh-pages": "^6.3.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.3",
    "sharp": "^0.34.5",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "vite": "^7.2.2",
    "vite-plugin-html": "^3.2.2",
    "web-vitals": "^5.1.0"
  }
}
